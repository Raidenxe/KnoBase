# ---- 环境密文(严禁提交) ----
.env
*.env.local

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ruff_cache/
.mypy_cache/

# ---- 运行数据(含敏感: 认证/工单/通知/会话等) ----
