data/*.db
data/*.db.lock
data/milvus_lite*
data/prompts.json
data/uploads/
data/backup/
data/manuals/
!data/manuals/.gitkeep

# ---- 运行时产物 ----
logs/
log/
*.log
.*.log
nohup.out
.run/

# ---- 编辑器 / 系统 ----
.DS_Store
*.swp
.idea/
.vscode/
