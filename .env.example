# ============================================================
# KnoBase RAG智能助手 环境变量示例
# 复制为 .env 后按需修改; 所有变量前缀 RAG_, 未配置时使用默认值
# ============================================================

# ---------- LLM ----------
# mock   : 离线抽取式回答(零幻觉, 无需 API Key, 适合演示/测试)
# openai : OpenAI 兼容 API(智谱 GLM / OpenAI / 通义 / vLLM 私有部署 等)
RAG_LLM_PROVIDER=mock
RAG_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RAG_LLM_API_KEY=
RAG_LLM_MODEL=glm-4-flash
RAG_LLM_TEMPERATURE=0.1

# ---------- 向量化 ----------
# fastembed : 本地 ONNX 模型(默认 BAAI/bge-small-zh-v1.5, 512 维, 中文优化)
# openai    : 兼容 Embedding API
RAG_EMBEDDING_PROVIDER=fastembed
RAG_FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
# huggingface.co 不可达时使用镜像; 可留空
RAG_HF_ENDPOINT=https://hf-mirror.com

# ---------- Milvus ----------
# 开发: ./data/milvus_lite.db (嵌入式, 零依赖)
# 生产: http://localhost:19530 (docker compose 启动的 Milvus 服务)
RAG_MILVUS_URI=./data/milvus_lite.db
RAG_MILVUS_COLLECTION=manual_chunks

# ---------- 检索与防幻觉(下列为经验精校后的推荐值) ----------
RAG_RETRIEVAL_TOP_K=8
RAG_RETRIEVAL_SCORE_THRESHOLD=0.42
RAG_KEYWORD_OVERLAP_MIN=0.10
RAG_MAX_CONTEXT_CHUNKS=4
RAG_GENERATION_MAX_RETRIES=1

# ---------- 知识库 ----------
RAG_MANUALS_DIR=./data/manuals
RAG_UPLOADS_DIR=./data/uploads
RAG_AUTO_INGEST_ON_STARTUP=true

# ---------- 混合检索(BM25 + RRF) ----------
RAG_HYBRID_BM25_K=8
RAG_RRF_K=60
RAG_RRF_VECTOR_WEIGHT=1.0
RAG_RRF_BM25_WEIGHT=1.25   # 精校: 适当上调关键词路权重可提升精确命中

# ---------- 文档版本管理 ----------
RAG_DOC_VERSIONS_DB_PATH=./data/versions.db

# ---------- 认证与多租户(RBAC) ----------
# off: 演示模式(默认, 无认证) ; on: 生产模式(启用 JWT 认证 / 角色 / 租户隔离)
RAG_AUTH_MODE=off
RAG_JWT_SECRET=
RAG_JWT_ALGORITHM=HS256
RAG_JWT_EXPIRE_HOURS=24
RAG_AUTH_DB_PATH=./data/auth.db
RAG_DEFAULT_TENANT=default

# ---------- 可观测性(全链路追踪) ----------
RAG_TRACE_DB_PATH=./data/trace.db
RAG_TRACE_TTL_SECONDS=3600

# ---------- 评估 ----------
RAG_EVAL_DATASET_PATH=./eval/dataset_kb.jsonl

# ---------- 服务 ----------
RAG_HOST=0.0.0.0
RAG_PORT=8000
